# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/influencer_finder

# Redis
REDIS_URL=redis://localhost:6379/0

# Apify
APIFY_TOKEN=your_apify_token
APIFY_GOOGLE_ACTOR=apify/google-search-scraper
APIFY_INSTAGRAM_ACTOR=apify/instagram-profile-scraper
APIFY_YOUTUBE_ACTOR=scrapio/youtube-scraper
APIFY_GOOGLE_PAGES_PER_QUERY=2
APIFY_INSTAGRAM_PROFILE_LIMIT=10
APIFY_MAX_PROFILES_PER_DAY=100
FRONTEND_ORIGIN=http://localhost:3000

# Optional hosted Supabase compatibility
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
